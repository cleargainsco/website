{
    "name": "danschultz/shop",
    "description": "A headless shop for Laravel: products, tiered pricing and stock, with extension points for custom product types.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "brick/money": "^0.10",
        "laravel/framework": "^13.0",
        "spatie/laravel-medialibrary": "^11.0",
        "intervention/image": "^4.0",
        "spatie/laravel-data": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Shop\\": "src/",
            "Shop\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shop\\ShopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
